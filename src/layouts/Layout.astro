---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = withBase('/og-image.svg') } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = `${title} · Fiara Permis`;
const swBase = import.meta.env.BASE_URL;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c1440e" />

    <!-- PWA -->
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Fiara Permis" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content="fr_MG" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'EducationalOrganization',
      name: 'Fiara Permis',
      description: "Cours en ligne pour préparer le code de la route à Madagascar (permis A, A', B et plus).",
      url: Astro.site?.toString(),
      areaServed: 'MG',
    })} />

    <script is:inline define:vars={{ swBase, isProd }}>
      if ('serviceWorker' in navigator) {
        if (isProd) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register(`${swBase}sw.js`, { scope: swBase }).catch(() => {
              // Offline support degrades gracefully to a normal online-only site.
            });
          });
        } else {
          // En dev, `sw.js` n'existe pas (il n'est généré qu'au build). Pire, un
          // service worker laissé par un `astro preview` sur le même hôte:port
          // continue de servir du HTML précaché : la page reçoit alors un vieux
          // token HMR et le websocket de Vite est rejeté. On nettoie.
          navigator.serviceWorker.getRegistrations().then((regs) => {
            regs.forEach((r) => r.unregister());
          });
          if (window.caches) {
            caches.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
          }
        }
      }
    </script>

    <script is:inline>
      // Plain global object (not an Alpine factory) so any component — quiz deck,
      // mock exam — can record right/wrong answers without sharing Alpine scope.
      // Révision espacée légère (boîtes de Leitner) : chaque question suit une
      // "boîte" de 0 à 3. Une bonne réponse monte d'une boîte, une mauvaise la
      // ramène à 0. Une question est à revoir tant que sa boîte est < 3, c'est-à-dire
      // tant qu'elle n'a pas été réussie 3 fois d'affilée. La file de révision
      // priorise les boîtes les plus basses puis les erreurs les plus récentes.
      window.mistakeTracker = {
        key: 'fiara-mistakes-v2',
        read() {
          let raw;
          try {
            raw = JSON.parse(localStorage.getItem(this.key) || 'null');
          } catch {
            raw = null;
          }
          if (raw === null) raw = this.migrate();
          return raw;
        },
        // Migration : l'ancien format (tableau d'ids, clé 'fiara-mistakes') devient
        // des entrées à la boîte 0, considérées comme ratées une fois.
        migrate() {
          let old;
          try {
            old = JSON.parse(localStorage.getItem('fiara-mistakes') || 'null');
          } catch {
            old = null;
          }
          if (!Array.isArray(old) || old.length === 0) return {};
          const map = {};
          const now = Date.now();
          old.forEach((id, i) => {
            map[id] = { box: 0, w: 1, r: 0, last: now - i };
          });
          localStorage.setItem(this.key, JSON.stringify(map));
          localStorage.removeItem('fiara-mistakes');
          return map;
        },
        write(map) {
          localStorage.setItem(this.key, JSON.stringify(map));
        },
        record(id, wasCorrect) {
          const map = this.read();
          const s = map[id] || { box: 0, w: 0, r: 0, last: 0 };
          if (wasCorrect) {
            s.r++;
            s.box = Math.min(s.box + 1, 3);
          } else {
            s.w++;
            s.box = 0;
          }
          s.last = Date.now();
          map[id] = s;
          this.write(map);
        },
        stats(id) {
          return this.read()[id] || null;
        },
        // Questions à revoir, ordonnées par priorité : boîte la plus basse
        // d'abord, puis la plus récemment passée.
        dueIds() {
          return Object.entries(this.read())
            .filter(([, s]) => s.box < 3)
            .sort((a, b) => a[1].box - b[1].box || b[1].last - a[1].last)
            .map(([id]) => id);
        },
        getIds() {
          return this.dueIds();
        },
        clear() {
          localStorage.setItem(this.key, '{}');
          localStorage.removeItem('fiara-mistakes');
        },
      };
    </script>

    <script>
      import { FIARA_DICT } from '../utils/i18n';
      declare global {
        interface Window {
          FIARA_DICT: typeof FIARA_DICT;
        }
      }
      window.FIARA_DICT = FIARA_DICT;
    </script>

    <script is:inline>
      // Scope global Alpine : langue FR/MG, modules terminés et traduction t().
      window.fiaraProgress = function () {
        return {
          lang: localStorage.getItem('fiara-lang') || 'fr',
          completed: JSON.parse(localStorage.getItem('fiara-done') || '[]'),
          init() {
            document.documentElement.lang = this.lang;
          },
          t(key) {
            const dict = window.FIARA_DICT || {};
            const table = dict[this.lang] || dict.fr || {};
            return table[key] ?? key;
          },
          // Champ d'une donnée (question, terme, panneau…) dans la langue
          // choisie : la version malagasy (`obj.mg`) si elle existe, sinon le
          // français.
          tr(obj, field) {
            if (!obj) return '';
            const mg = this.lang === 'mg' && obj.mg ? obj.mg[field] : undefined;
            return mg ?? obj[field];
          },
          setLang(l) {
            this.lang = l;
            localStorage.setItem('fiara-lang', l);
            document.documentElement.lang = l;
          },
          // Catégories de permis préparées par l'utilisateur. Tableau vide =
          // aucun choix fait, on montre alors tout le parcours.
          cats: JSON.parse(localStorage.getItem('fiara-cats') || '[]'),
          toggleCat(c) {
            this.cats = this.cats.includes(c)
              ? this.cats.filter((x) => x !== c)
              : [...this.cats, c];
            localStorage.setItem('fiara-cats', JSON.stringify(this.cats));
          },
          clearCats() {
            this.cats = [];
            localStorage.setItem('fiara-cats', '[]');
          },
          // Prérequis entre catégories (module PK 6) : le permis C exige le B,
          // le permis E exige le B et le C. Préparer E implique donc de réviser
          // aussi le contenu C — on développe la sélection en conséquence.
          get catsWithPrereqs() {
            const PREREQ = { C: ['B'], E: ['B', 'C'] };
            const out = new Set();
            for (const c of this.cats) {
              out.add(c);
              for (const p of PREREQ[c] || []) out.add(p);
            }
            return [...out];
          },
          // Catégorie affichée uniquement parce qu'elle est prérequise.
          isImplied(c) {
            return !this.cats.includes(c) && this.catsWithPrereqs.includes(c);
          },
          // Un module sans catégorie est commun : toujours visible. Un module
          // spécifique n'apparaît que si l'utilisateur prépare l'une des
          // catégories concernées, prérequis compris.
          showsModule(moduleCats) {
            if (!moduleCats || moduleCats.length === 0) return true;
            if (this.cats.length === 0) return true;
            const active = this.catsWithPrereqs;
            return moduleCats.some((c) => active.includes(c));
          },
          isDone(id) {
            return this.completed.includes(id);
          },
          toggle(id) {
            this.completed = this.completed.includes(id)
              ? this.completed.filter((x) => x !== id)
              : [...this.completed, id];
            localStorage.setItem('fiara-done', JSON.stringify(this.completed));
          },
        };
      };
    </script>

    <script is:inline>
      // Cartes / quiz noté par module. En mode quiz, chaque réponse est
      // enregistrée dans mistakeTracker (révision espacée des erreurs).
      window.quizDeck = function (questions) {
        return {
          mode: 'cards',
          questions: [...questions],
          index: 0,
          score: 0,
          selected: null,
          finished: false,
          flipped: false,
          get current() {
            return this.questions[this.index];
          },
          get isLast() {
            return this.index === this.questions.length - 1;
          },
          // Boîte de Leitner d'une question (0-3), pour la page « Réviser mes
          // erreurs » : box 0 = 1re reprise, box 3 = maîtrisée.
          boxOf(id) {
            const s = window.mistakeTracker.stats(id);
            return s ? s.box : 0;
          },
          get masteredCount() {
            return this.questions.filter((q) => this.boxOf(q.id) >= 3).length;
          },
          get remainingCount() {
            return this.questions.length - this.masteredCount;
          },
          // Page « Réviser mes erreurs » : fige le niveau de reprise au début
          // de la série, pour étiqueter chaque question sans que le compteur
          // n'avance dès qu'on répond juste.
          snapshotBoxes() {
            this._startBox = {};
            this.questions.forEach((q) => {
              const s = window.mistakeTracker.stats(q.id);
              this._startBox[q.id] = s ? s.box : 0;
            });
          },
          repriseOf(id) {
            const base =
              this._startBox && this._startBox[id] !== undefined
                ? this._startBox[id]
                : this.boxOf(id);
            return base + 1;
          },
          setMode(m) {
            this.mode = m;
            this.restart();
          },
          flip() {
            this.flipped = !this.flipped;
          },
          prevCard() {
            if (this.index > 0) {
              this.index--;
              this.flipped = false;
            }
          },
          nextCard() {
            if (this.index < this.questions.length - 1) {
              this.index++;
              this.flipped = false;
            }
          },
          choose(i) {
            if (this.selected !== null) return;
            this.selected = i;
            const q = this.current;
            const correct = i === q.correctIndex;
            if (correct) this.score++;
            window.mistakeTracker.record(q.id, correct);
          },
          nextQuestion() {
            if (this.selected === null) return;
            this.selected = null;
            this.index++;
            if (this.index >= this.questions.length) {
              this.index = this.questions.length - 1;
              this.finished = true;
            }
          },
          restart() {
            this.index = 0;
            this.score = 0;
            this.selected = null;
            this.finished = false;
            this.flipped = false;
          },
        };
      };
    </script>

    <script is:inline>
      // Shuffle Fisher-Yates sécurisé (crypto) — partagé par signQuiz et mockExam.
      window._fiaraShuffle = function (a) {
        const arr = [...a];
        const rnd = new Uint32Array(arr.length);
        crypto.getRandomValues(rnd);
        for (let i = arr.length - 1; i > 0; i--) {
          const j = rnd[i] % (i + 1);
          [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
      };

      // Reconnaissance de panneaux : 8 panneaux tirés au sort, 4 propositions.
      window.signQuiz = function (signs) {
        const TOTAL = 8;
        return {
          pool: [],
          total: TOTAL,
          round: 0,
          score: 0,
          selected: null,
          finished: false,
          get current() {
            return this.pool[this.round];
          },
          // 4 propositions stables par tour : le bon panneau + 3 leurres.
          get options() {
            if (this._roundKey !== this.round) {
              const good = this.current;
              // Leurres de la même famille d'abord : distinguer deux panneaux
              // ronds bleus est le vrai exercice, pas un rond d'un triangle.
              const others = signs.filter((s) => s.id !== good.id);
              const same = _fiaraShuffle(others.filter((s) => s.category === good.category));
              const rest = _fiaraShuffle(others.filter((s) => s.category !== good.category));
              const decoys = [...same, ...rest].slice(0, 3);
              this._options = _fiaraShuffle([good, ...decoys]);
              this._roundKey = this.round;
            }
            return this._options;
          },
          init() {
            this.pool = _fiaraShuffle(signs).slice(0, TOTAL);
            this.round = 0;
            this.score = 0;
            this.selected = null;
            this.finished = false;
            this._roundKey = null;
          },
          choose(id) {
            if (this.selected !== null) return;
            this.selected = id;
            if (id === this.current.id) this.score++;
          },
          next() {
            if (this.selected === null) return;
            if (this.round === this.total - 1) {
              this.finished = true;
            } else {
              this.round++;
              this.selected = null;
            }
          },
          restart() {
            this.init();
          },
        };
      };
    </script>

    <script is:inline>
      // Cas pratiques : vrai / faux sur des situations concrètes.
      window.trueFalseGame = function (scenarios) {
        return {
          scenarios: [...scenarios],
          index: 0,
          score: 0,
          selected: null,
          finished: false,
          get current() {
            return this.scenarios[this.index];
          },
          answer(v) {
            if (this.selected !== null) return;
            this.selected = v;
            if (v === this.current.answer) this.score++;
          },
          next() {
            if (this.selected === null) return;
            if (this.index === this.scenarios.length - 1) {
              this.finished = true;
            } else {
              this.index++;
              this.selected = null;
            }
          },
          restart() {
            this.index = 0;
            this.score = 0;
            this.selected = null;
            this.finished = false;
          },
        };
      };
    </script>

    <script is:inline>
      // Examen blanc : pool aléatoire, chronomètre, enregistrement des
      // réponses dans mistakeTracker.
      window.mockExam = function (allQuestions, total, duration) {
        return {
          // Réservoir de questions, exposé pour que la page puisse le filtrer
          // sur les catégories choisies avant d'appeler init().
          source: allQuestions,
          pool: [],
          total,
          index: 0,
          score: 0,
          selected: null,
          finished: false,
          timeLeft: duration,
          timer: null,
          get current() {
            return this.pool[this.index];
          },
          get minutes() {
            return String(Math.floor(this.timeLeft / 60)).padStart(2, '0');
          },
          get seconds() {
            return String(this.timeLeft % 60).padStart(2, '0');
          },
          init() {
            const src = this.source.length ? this.source : allQuestions;
            this.pool = _fiaraShuffle(src).slice(0, total);
            this.total = Math.min(total, this.pool.length);
            this.index = 0;
            this.score = 0;
            this.selected = null;
            this.finished = false;
            this.timeLeft = duration;
            if (this.timer) clearInterval(this.timer);
            this.timer = setInterval(() => {
              if (this.finished) {
                clearInterval(this.timer);
                return;
              }
              this.timeLeft--;
              if (this.timeLeft <= 0) {
                clearInterval(this.timer);
                this.finished = true;
              }
            }, 1000);
          },
          choose(i) {
            if (this.selected !== null) return;
            this.selected = i;
            const q = this.current;
            const correct = i === q.correctIndex;
            if (correct) this.score++;
            window.mistakeTracker.record(q.id, correct);
          },
          next() {
            if (this.selected === null) return;
            if (this.index === this.pool.length - 1) {
              this.finished = true;
              clearInterval(this.timer);
            } else {
              this.index++;
              this.selected = null;
            }
          },
          restart() {
            this.init();
          },
        };
      };
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-body antialiased" x-data="fiaraProgress()">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-route focus:text-sisal focus:px-4 focus:py-2 focus:rounded">
      Aller au contenu
    </a>
    <Nav />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
