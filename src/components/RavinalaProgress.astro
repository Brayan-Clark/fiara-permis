---
import { getModuleCount } from '../utils/modules';

interface Props {
  size?: 'compact' | 'full';
}
const { size = 'compact' } = Astro.props;

const total = await getModuleCount();

// Éventail du ravinala calculé pour le nombre réel de modules : les feuilles
// s'étalent régulièrement de -80° à +80° autour de la verticale et s'allument
// de gauche à droite au fil de la progression.
// Construit ici plutôt que dans l'attribut : un littéral de gabarit imbriqué
// dans une expression Astro fait échouer le parseur JSX.
const doneExpr = "`/ " + total + " ${t('module.done')}`";

const RADIUS = 24;
const SPREAD = 80;
const leaves = Array.from({ length: total }, (_, i) => {
  const deg = total === 1 ? 0 : -SPREAD + (2 * SPREAD * i) / (total - 1);
  const rad = (deg * Math.PI) / 180;
  return {
    x: 32 + RADIUS * Math.sin(rad),
    y: 30 - RADIUS * Math.cos(rad),
    rot: deg,
  };
});
---

<div class:list={["flex items-center gap-3", size === 'full' && 'flex-col gap-2']}>
  <svg viewBox="0 0 64 64" class:list={[size === 'compact' ? 'h-10 w-10' : 'h-28 w-28']} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <line x1="32" y1="60" x2="32" y2="30" stroke="var(--color-route)" stroke-opacity="0.25" stroke-width="3" stroke-linecap="round" />
    {leaves.map((l, i) => (
      <g>
        <line x1="32" y1="30" x2={l.x} y2={l.y} stroke="var(--color-route)" stroke-opacity="0.2" stroke-width="3" stroke-linecap="round" />
        <ellipse
          cx={l.x}
          cy={l.y}
          rx="4"
          ry="7"
          transform={`rotate(${l.rot} ${l.x} ${l.y})`}
          fill="var(--color-ravinala)"
          x-bind:opacity={`completed.length > ${i} ? 1 : 0.18`}
          style="transition: opacity 400ms ease"
        />
      </g>
    ))}
  </svg>
  <p class:list={["font-plate text-route", size === 'compact' ? 'text-xs' : 'text-sm']}>
    <span x-text="completed.length" class="font-semibold text-laterite">0</span>
    <span x-text={doneExpr}>/ {total} modules terminés</span>
  </p>
</div>
