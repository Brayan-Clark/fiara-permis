---
// Sélecteur de catégories de permis. L'état vit dans fiaraProgress() (posé sur
// <body>), donc le choix est partagé par toutes les pages et persisté dans
// localStorage sous 'fiara-cats', comme la progression et la langue.
const categories = [
  { code: 'A', label: 'Moto', labelMg: 'Moto' },
  { code: "A'", label: 'Moto légère', labelMg: 'Moto maivana' },
  { code: 'B', label: 'Voiture', labelMg: 'Fiara' },
  { code: 'C', label: 'Poids lourd', labelMg: 'Kamiao lehibe' },
  { code: 'D', label: 'Transport de personnes', labelMg: 'Fitaterana olona' },
  { code: 'E', label: 'Remorque', labelMg: 'Remorque' },
];
---

<div class="rounded-2xl border-2 border-route/12 bg-white/70 p-5 sm:p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="font-display text-base font-semibold text-route" x-text="t('cat.title')">
      Quelles catégories prépares-tu ?
    </h2>
    <button
      type="button"
      x-show="cats.length > 0"
      x-cloak
      @click="clearCats()"
      class="text-xs font-medium text-laterite hover:underline"
      x-text="t('cat.reset')"
    >Tout afficher</button>
  </div>

  <p class="mt-1.5 text-sm text-ink-soft" x-text="t('cat.help')">
    Le tronc commun reste toujours affiché. Choisir une ou plusieurs catégories masque seulement les
    modules propres aux autres.
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    {categories.map((c) => (
      <button
        type="button"
        @click={`toggleCat("${c.code}")`}
        :class={`cats.includes("${c.code}") ? 'border-signal bg-signal text-sisal' : (isImplied("${c.code}") ? 'border-signal/50 bg-signal/10 text-signal' : 'border-route/20 text-route hover:border-signal/50')`}
        class="inline-flex items-center gap-2 rounded-full border-2 px-3.5 py-1.5 text-sm font-medium transition"
        :aria-pressed={`cats.includes("${c.code}")`}
        :title={`isImplied("${c.code}") ? t('cat.impliedTitle') : ''`}
      >
        <span class="font-plate font-semibold">{c.code}</span>
        <span class="text-xs opacity-80"><span x-show="lang !== 'mg'">{c.label}</span><span x-show="lang === 'mg'" x-cloak lang="mg">{c.labelMg}</span></span>
        <span x-show={`isImplied("${c.code}")`} x-cloak class="font-plate text-[0.6rem] uppercase tracking-wide" x-text="t('cat.implied')">requis</span>
      </button>
    ))}
  </div>

  <p
    class="mt-3 text-xs text-ink-soft"
    x-show="cats.length === 0"
    x-cloak
    x-text="t('cat.none')"
  >Aucune catégorie choisie : tout le parcours est affiché.</p>
</div>
