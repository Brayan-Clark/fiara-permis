---
import Layout from '../../layouts/Layout.astro';
import ModuleCard from '../../components/ModuleCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/url';

const modules = (await getCollection('cours')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Le cours, module par module"
  description="Tous les modules du code de la route à Madagascar : signalisation, priorités, vitesse, sécurité, stationnement, catégories de permis, infractions et sanctions."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
    <span class="inline-flex items-center gap-2 rounded-full border border-signal/30 bg-signal/10 px-3 py-1 text-xs font-medium text-signal">
      <span x-text="t('cours.badge')">Parcours complet</span>
    </span>
    <h1 class="mt-4 font-display text-3xl sm:text-4xl font-semibold text-route" x-text="t('cours.title')">Le cours, borne après borne</h1>
    <p class="mt-3 max-w-2xl text-ink-soft" x-text="t('cours.intro')">
      Chaque module est numéroté comme un point kilométrique sur une route nationale. Suis l'ordre pour une progression logique, ou saute directement au module qui te manque avant l'examen.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {modules.map((mod) => (
        <ModuleCard
          href={withBase(`/cours/${mod.id}`)}
          pk={mod.data.pk}
          title={mod.data.title}
          summary={mod.data.summary}
          accent={mod.data.accent}
          slug={mod.id}
        />
      ))}
    </div>

    <a
      href={withBase('/livret')}
      class="mt-10 flex flex-wrap items-center gap-4 rounded-2xl border-2 border-route/15 bg-route p-6 text-sisal transition hover:border-sun/40"
    >
      <svg class="h-8 w-8 shrink-0 text-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z" />
      </svg>
      <div class="min-w-0 flex-1">
        <h2 class="font-display text-lg font-semibold" x-text="t('livret.cta')">Télécharger le livret en PDF</h2>
        <p class="mt-1 text-sm text-sisal/75" x-text="t('livret.ctaDesc')">Tout le cours en un seul document, à lire hors connexion ou à imprimer.</p>
      </div>
      <span class="text-sun" aria-hidden="true">→</span>
    </a>
  </section>
</Layout>
