---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/url';

// Liens sortants uniquement, jamais d'iframe : une intégration Facebook ou
// YouTube charge des scripts tiers, casse le fonctionnement hors connexion et
// impose du pistage à chaque visiteur. Le lien fait le même travail sans rien
// coûter à ceux qui lisent l'application en mode avion.
const resources = [
  {
    name: "ALF — Aro Lozan'ny Fifamoivoizana",
    kind: 'Vidéos et sensibilisation',
    lang: 'Malagasy',
    description:
      "Prévention routière en malgache : vidéos, leçons et campagnes de sensibilisation, relayées par le Ministère des Transports. Idéal pour entendre les règles expliquées dans ta langue, en complément des modules d'ici.",
    url: 'https://www.facebook.com/arolozannyfifamoivoizana/',
    accent: 'ravinala',
  },
  {
    name: 'Ministère des Transports et de la Météorologie',
    kind: 'Source officielle',
    lang: 'Malagasy / Français',
    description:
      "La page du ministère publie les annonces officielles : campagnes de sécurité routière, changements de procédure, sessions d'examen. C'est là que passe l'information avant partout ailleurs.",
    url: 'https://www.facebook.com/MinTransports/',
    accent: 'signal',
  },
  {
    name: 'Guide des usagers de la route (PDF)',
    kind: 'Document de référence',
    lang: 'Malagasy / Français',
    description:
      "Le document co-signé BIANCO / Ministère des Transports / Police nationale / Gendarmerie. Bilingue, il liste les infractions avec leurs sanctions et la procédure de contrôle. C'est la source principale des modules PK 7 à PK 11 de cette application.",
    url: 'https://www.bianco-mg.org/uploads/documentation/guide-des-usagers-de-la-route2.pdf',
    accent: 'laterite',
  },
  {
    name: 'Loi n°2017-002 portant Code de la Route',
    kind: 'Texte de loi',
    lang: 'Français',
    description:
      "La fiche du texte de loi, avec accès au PDF. Dense et juridique — à consulter quand tu veux vérifier un point précis à la source plutôt que dans un résumé. Le PDF hébergé par l'Assemblée nationale n'est plus accessible directement.",
    url: 'https://textes.lexxika.com/lois-malagasy/loi-n2017-002-du-06-juillet-2016-portant-code-de-la-route-a-madagascar/',
    accent: 'sun',
  },
  {
    name: 'Décision n°14-HCC/D3 du 5 juillet 2017',
    kind: 'Source officielle',
    lang: 'Français',
    description:
      "La décision de la Haute Cour constitutionnelle sur la loi n°2017-002, publiée sur le site de la HCC. C'est elle qui a rendu le code de la route actuel applicable.",
    url: 'http://www.hcc.gov.mg/?p=2952',
    accent: 'signal',
  },
];

const border: Record<string, string> = {
  laterite: 'border-laterite/30',
  ravinala: 'border-ravinala/30',
  signal: 'border-signal/30',
  sun: 'border-sun/40',
};
const text: Record<string, string> = {
  laterite: 'text-laterite',
  ravinala: 'text-ravinala',
  signal: 'text-signal',
  sun: 'text-sun-ink',
};
---

<Layout
  title="Ressources et vidéos"
  description="Vidéos de sensibilisation, pages officielles et documents de référence pour compléter le cours du code de la route à Madagascar."
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-14 sm:py-20">
    <h1 class="font-display text-3xl sm:text-4xl font-semibold text-route">
      <span x-text="t('res.title')">Aller plus loin</span>
    </h1>
    <p class="mt-3 text-lg text-ink-soft">
      <span x-text="t('res.intro')"
        >Des vidéos et des sources officielles pour compléter le cours — notamment en malgache, si
        les explications passent mieux dans ta langue.</span
      >
    </p>

    <p
      class="mt-6 flex items-start gap-2 rounded-xl border border-signal/25 bg-signal/5 p-4 text-sm text-ink-soft"
    >
      <svg class="mt-0.5 h-4 w-4 shrink-0 text-signal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" />
      </svg>
      <span x-text="t('res.offline')"
        >Ces liens mènent vers des sites extérieurs et demandent une connexion. Les modules, quiz et
        exercices de Fiara Permis, eux, restent utilisables hors connexion.</span
      >
    </p>

    <div class="mt-10 grid gap-5">
      {resources.map((r) => (
        <a
          href={r.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={['group rounded-2xl border-2 bg-white/70 p-6 transition hover:shadow-lg hover:shadow-route/5', border[r.accent]]}
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class:list={['font-plate text-[0.65rem] uppercase tracking-widest', text[r.accent]]}>{r.kind}</span>
            <span class="font-plate text-[0.65rem] uppercase tracking-widest text-ink-soft">{r.lang}</span>
          </div>
          <h2 class="mt-2 font-display text-lg font-semibold text-route group-hover:underline">
            {r.name}
            <span class="ml-1 inline-block align-middle text-ink-soft">↗</span>
          </h2>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">{r.description}</p>
        </a>
      ))}
    </div>

    <div class="mt-10 rounded-2xl border border-route/10 bg-white/60 p-5 text-sm text-ink-soft">
      <p class="font-semibold text-route" x-text="t('res.noteTitle')">Pourquoi des liens et pas des vidéos intégrées</p>
      <p class="mt-2">
        <span x-text="t('res.note')"
          >Intégrer les vidéos directement dans la page obligerait à charger des scripts Facebook sur
          chaque visite : l'application deviendrait plus lourde, inutilisable hors connexion, et
          chaque visiteur serait pisté même sans cliquer. Le lien donne accès au même contenu sans
          rien imposer à ceux qui révisent en mode avion.</span
        >
      </p>
    </div>

    <div class="mt-8">
      <a href={withBase('/sources')} class="text-sm font-medium text-laterite hover:underline">
        <span x-text="t('res.allSources')">Voir toutes les sources du cours →</span>
      </a>
    </div>
  </section>
</Layout>
