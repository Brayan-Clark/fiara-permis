---
import Layout from '../../layouts/Layout.astro';
import { panneaux } from '../../data/panneaux';
import { withBase } from '../../utils/url';
---

<Layout
  title="Reconnaissance de panneaux"
  description="Identifie chaque panneau routier malgache le plus vite possible parmi 4 propositions."
>
  <section
    class="mx-auto max-w-xl px-4 sm:px-6 py-14 sm:py-20"
    x-data={`signQuiz(${JSON.stringify(panneaux)})`}
    x-init="init()"
  >
    <a href={withBase('/exercices')} class="text-sm text-ink-soft hover:text-laterite"><span x-text="t('exo.back')">← Tous les exercices</span></a>
    <h1 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-route"><span x-text="t('exo.signsTitle')">Reconnaissance de panneaux</span></h1>

    <template x-if="!finished">
      <div>
        <p class="mt-6 font-plate text-xs text-ink-soft">
          <span x-text="t('exo.sign')">Panneau</span> <span x-text="round + 1"></span> / <span x-text="total"></span>
          &middot; <span x-text="t('quiz.score')">Score</span> : <span x-text="score"></span>
        </p>

        <div class="mt-4 flex justify-center rounded-2xl border-2 border-route/10 bg-white/70 p-10">
          <div class="h-32 w-32" x-html="current.svg"></div>
        </div>

        <div class="mt-6 grid gap-2.5">
          <template x-for="opt in options" :key="opt.id">
            <button
              type="button"
              @click="choose(opt.id)"
              :class="{ 'border-ravinala bg-ravinala/10 text-route': selected !== null && opt.id === current.id, 'border-laterite bg-laterite/10 text-route': selected === opt.id && opt.id !== current.id, 'border-route/15 hover:border-signal/40': selected === null, 'border-route/10 opacity-60': selected !== null && opt.id !== current.id && opt.id !== selected }"
              class="rounded-xl border-2 px-4 py-3 text-left text-sm font-medium transition"
            >
              <span x-text="opt.name"></span>
            </button>
          </template>
        </div>

        <div class="mt-6 flex justify-end">
          <button
            type="button"
            x-show="selected !== null"
            x-cloak
            @click="next()"
            class="rounded-full bg-route px-5 py-2 text-sm font-semibold text-sisal hover:bg-route/90"
            x-text="round === total - 1 ? t('action.seeResult') : t('exo.signNext')"
          ></button>
        </div>
      </div>
    </template>

    <template x-if="finished">
      <div class="mt-6 rounded-2xl border-2 border-route/10 bg-white/70 p-8 text-center">
        <p class="font-plate text-xs uppercase tracking-widest text-ink-soft"><span x-text="t('quiz.result')">Résultat</span></p>
        <p class="mt-2 font-display text-4xl font-semibold text-route"><span x-text="score"></span> / <span x-text="total"></span></p>
        <div class="mt-6 flex justify-center gap-3">
          <button type="button" @click="restart()" class="rounded-full bg-laterite px-5 py-2.5 text-sm font-semibold text-sisal hover:bg-laterite-dark"><span x-text="t('action.restart')">Recommencer</span></button>
          <a href={withBase('/exercices')} class="rounded-full border-2 border-route px-5 py-2.5 text-sm font-semibold text-route hover:bg-route hover:text-sisal"><span x-text="t('exo.other')">Autre exercice</span></a>
        </div>
      </div>
    </template>
  </section>
</Layout>
