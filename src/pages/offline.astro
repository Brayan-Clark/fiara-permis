---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/url';
---

<Layout
  title="Hors connexion — Fiara Permis"
  description="Tu es hors ligne et cette page n'a pas encore été mise en cache. Reconnecte-toi ou navigue vers une page déjà visitée."
>
  <section class="mx-auto max-w-lg px-4 sm:px-6 py-24 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-laterite/10 text-laterite">
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 8.82a15 15 0 0 1 20 0" />
        <path d="M5 12.86a10 10 0 0 1 14 0" />
        <path d="M8.5 16.9a5 5 0 0 1 7 0" />
        <line x1="12" y1="20" x2="12.01" y2="20" />
        <line x1="2" y1="2" x2="22" y2="22" />
      </svg>
    </div>
    <h1 class="mt-6 font-display text-2xl font-semibold text-route"><span x-text="t('offline.title')">Pas de connexion</span></h1>
    <p class="mt-3 text-ink-soft">
      <span x-text="t('offline.desc')">Cette page précise n'a pas encore été enregistrée sur ton appareil. Les pages déjà visitées, elles, restent disponibles hors connexion — reviens à l'accueil pour continuer à réviser.</span>
    </p>
    <a href={withBase('/')} class="mt-6 inline-block rounded-full bg-laterite px-6 py-3 text-sm font-semibold text-sisal hover:bg-laterite-dark">
      <span x-text="t('offline.home')">Retour à l'accueil</span>
    </a>
  </section>
</Layout>
