---
import Layout from '../layouts/Layout.astro';
import { glossary } from '../data/glossary';
---

<Layout
  title="Glossaire du code de la route"
  description="Les termes du code de la route à Madagascar expliqués simplement : croisement, dépassement, priorité, distances de sécurité et de freinage, panneaux…"
>
  <section
    class="mx-auto max-w-2xl px-4 sm:px-6 py-14 sm:py-20"
    x-data={`{ query: '', terms: ${JSON.stringify(glossary)}, get filtered() { const q = this.query.toLowerCase(); return this.terms.filter(t => [t.term, t.definition, t.mg?.term, t.mg?.definition].join(' ').toLowerCase().includes(q)) } }`}
  >
    <span class="inline-flex items-center gap-2 rounded-full border border-signal/30 bg-signal/10 px-3 py-1 text-xs font-medium text-signal">
      <span x-text="t('glossary.badge')">Référence rapide</span>
    </span>
    <h1 class="mt-4 font-display text-3xl sm:text-4xl font-semibold text-route"><span x-text="t('glossary.title')">Glossaire</span></h1>
    <p class="mt-3 text-ink-soft"><span x-text="t('glossary.intro')">Les mots du code de la route, expliqués en une phrase. Utile pour un dernier coup d'œil avant l'examen.</span></p>

    <div class="mt-6 relative">
      <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        id="glossary-search"
        type="text"
        x-model="query"
        :placeholder="t('glossary.search')"
        placeholder="Chercher un terme (ex. dépassement, priorité…)"
        class="w-full rounded-full border-2 border-route/15 bg-white/70 py-3 pl-11 pr-4 text-sm text-route placeholder:text-ink-soft/60 focus:border-signal outline-none"
        aria-label="Rechercher un terme du glossaire"
        autocomplete="off"
      />
    </div>

    <dl class="mt-8 space-y-5">
      <template x-for="item in filtered" :key="item.term">
        <div class="rounded-xl border border-route/10 bg-white/60 p-5">
          <dt class="font-display font-semibold text-route" x-text="tr(item, 'term')"></dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink-soft" x-text="tr(item, 'definition')"></dd>
        </div>
      </template>
      <p x-show="filtered.length === 0" x-cloak class="text-sm text-ink-soft"><span x-text="t('glossary.empty')">Aucun terme ne correspond à cette recherche.</span></p>
    </dl>
  </section>
</Layout>
