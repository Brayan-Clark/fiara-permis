---
import Layout from '../../layouts/Layout.astro';
import QuizChoice from '../../components/QuizChoice.astro';
import { quizModules, getQuizModule, withSignVisuals } from '../../data/quiz';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  return quizModules.map((mod) => ({ params: { slug: mod.slug } }));
}

const { slug } = Astro.params;
const mod = getQuizModule(slug!)!;

const accentBg: Record<string, string> = {
  laterite: 'bg-laterite',
  ravinala: 'bg-ravinala',
  signal: 'bg-signal',
  sun: 'bg-sun',
};
---

<Layout title={`Quiz — ${mod.title}`} description={`Cartes et quiz noté sur : ${mod.title}.`}>
  <section
    class="mx-auto max-w-2xl px-4 sm:px-6 py-14 sm:py-20"
    x-data={`quizDeck(${JSON.stringify(withSignVisuals(mod.questions))})`}
  >
    <a href={withBase('/quiz')} class="text-sm text-ink-soft hover:text-laterite"><span x-text="t('quiz.back')">← Tous les paquets</span></a>
    <h1 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-route">
      <span x-show={mod.titleMg ? "lang !== 'mg'" : 'true'}>{mod.title}</span>
      {mod.titleMg && <span x-show="lang === 'mg'" x-cloak lang="mg">{mod.titleMg}</span>}
    </h1>

    <div class="mt-6 inline-flex rounded-full border border-route/15 bg-white/70 p-1 text-sm">
      <button
        type="button"
        @click="setMode('cards')"
        :class="mode === 'cards' ? 'bg-route text-sisal' : 'text-route'"
        class="rounded-full px-4 py-1.5 font-medium transition"
      >
        <span x-text="t('quiz.cardsMode')">Cartes</span>
      </button>
      <button
        type="button"
        @click="setMode('quiz')"
        :class="mode === 'quiz' ? 'bg-route text-sisal' : 'text-route'"
        class="rounded-full px-4 py-1.5 font-medium transition"
      >
        <span x-text="t('quiz.quizMode')">Quiz noté</span>
      </button>
    </div>

    <!-- Progress -->
    <p class="mt-6 font-plate text-xs text-ink-soft" x-text={`(mode === 'cards' ? t('quiz.card') : t('quiz.question')) + ' ' + (index + 1) + ' / ' + questions.length`}></p>

    <!-- FLASHCARD MODE -->
    <div x-show="mode === 'cards'" x-cloak>
      <div class="flip-scene mt-3 h-80 sm:h-72">
        <div class="flip-card h-full w-full" :class="{ 'is-flipped': flipped }">
          <button
            type="button"
            @click="flip()"
            class:list={['flip-face absolute inset-0 flex flex-col items-center justify-center rounded-2xl border-2 p-8 text-center shadow-lg', 'border-route/10 bg-white']}
          >
            <p class="font-plate text-xs uppercase tracking-widest text-ink-soft" x-text="t('quiz.question')">Question</p>
            <div x-show="current.signHtml" class="mt-3 h-24 w-24" x-html="current.signHtml"></div>
            <p class="mt-4 font-display text-lg sm:text-xl font-semibold text-route" x-text="tr(current, 'question')"></p>
            <p class="mt-6 text-xs text-ink-soft" x-text="t('quiz.tapHint')">Touche la carte pour voir la réponse</p>
          </button>
          <button
            type="button"
            @click="flip()"
            class:list={['flip-face flip-face-back flex flex-col items-center justify-center rounded-2xl border-2 p-8 text-center shadow-lg', accentBg[mod.accent], 'border-route/10 text-sisal']}
          >
            <p class="font-plate text-xs uppercase tracking-widest text-sisal/70" x-text="t('quiz.answer')">Réponse</p>
            <p class="mt-4 font-display text-lg font-semibold" x-text="tr(current, 'choices')[current.correctIndex]"></p>
            <p class="mt-4 text-sm text-sisal/85" x-text="tr(current, 'explanation')"></p>
          </button>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-between">
        <button type="button" @click="prevCard()" class="rounded-full border-2 border-route px-5 py-2 text-sm font-semibold text-route hover:bg-route hover:text-sisal">
          <span x-text="t('action.prev')">← Précédente</span>
        </button>
        <button type="button" @click="nextCard()" class="rounded-full bg-laterite px-5 py-2 text-sm font-semibold text-sisal hover:bg-laterite-dark">
          <span x-text="t('action.next')">Suivante →</span>
        </button>
      </div>
    </div>

    <!-- QUIZ MODE -->
    <div x-show="mode === 'quiz'" x-cloak>
      <template x-if="!finished">
        <div class="mt-3 rounded-2xl border border-route/10 bg-white/70 p-6">
          <div x-show="current.signHtml" class="mx-auto h-24 w-24" x-html="current.signHtml"></div>
          <p class="font-display text-lg font-semibold text-route" x-text="tr(current, 'question')"></p>
          <div class="mt-5 space-y-2.5">
            <template x-for="(choice, i) in tr(current, 'choices')" :key="i">
              <QuizChoice />
            </template>
          </div>

          <p x-show="selected !== null" x-cloak class="mt-4 rounded-lg bg-sun/15 p-3 text-sm text-route" x-text="tr(current, 'explanation')"></p>

          <div class="mt-5 flex items-center justify-between">
            <p class="font-plate text-xs text-ink-soft"><span x-text="t('quiz.score')">Score</span> : <span x-text="score"></span> / <span x-text="questions.length"></span></p>
            <button
              type="button"
              x-show="selected !== null"
              x-cloak
              @click="nextQuestion()"
              class="rounded-full bg-route px-5 py-2 text-sm font-semibold text-sisal hover:bg-route/90"
              aria-label="Question suivante"
              x-text="isLast ? t('action.seeResult') : t('action.nextQuestion')"
            >Question suivante</button>
          </div>
        </div>
      </template>

      <template x-if="finished">
        <div class="mt-3 rounded-2xl border-2 border-route/10 bg-white/70 p-8 text-center">
          <p class="font-plate text-xs uppercase tracking-widest text-ink-soft" x-text="t('quiz.result')">Résultat</p>
          <p class="mt-2 font-display text-4xl font-semibold text-route">
            <span x-text="score"></span> / <span x-text="questions.length"></span>
          </p>
          <p class="mt-2 text-sm text-ink-soft" x-text="score === questions.length ? t('quiz.resultPerfect') : (score / questions.length >= 0.7 ? t('quiz.resultGood') : t('quiz.resultBad'))"></p>
          <div class="mt-6 flex justify-center gap-3">
            <button type="button" @click="restart()" class="rounded-full bg-laterite px-5 py-2.5 text-sm font-semibold text-sisal hover:bg-laterite-dark"><span x-text="t('action.restart')">Recommencer</span></button>
            <a href={withBase('/quiz')} class="rounded-full border-2 border-route px-5 py-2.5 text-sm font-semibold text-route hover:bg-route hover:text-sisal"><span x-text="t('quiz.otherPack')">Autre paquet</span></a>
          </div>
        </div>
      </template>
    </div>
  </section>
</Layout>
