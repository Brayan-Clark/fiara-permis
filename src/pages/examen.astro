---
import Layout from '../layouts/Layout.astro';
import { quizModules } from '../data/quiz';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';

// Chaque question porte les catégories de son module : l'examen blanc ne doit
// pas poser de questions poids lourd à quelqu'un qui prépare A, A' et B.
const cours = await getCollection('cours');
const catsBySlug = new Map(cours.map((m) => [m.id, m.data.categories ?? []]));
const allQuestions = quizModules.flatMap((m) =>
  m.questions.map((qu) => ({ ...qu, cats: catsBySlug.get(m.slug) ?? [] })),
);
const TOTAL = 20;
const DURATION = 600; // 10 minutes — a self-practice pace, not an official exam timing
const PASS_THRESHOLD = 16; // 80% — a common convention for code exams, to confirm with your driving school
---

<Layout
  title="Examen blanc"
  description="20 questions mélangées de tous les modules du code de la route, chronométrées, pour t'entraîner comme le jour de l'examen."
>
  <section
    class="mx-auto max-w-2xl px-4 sm:px-6 py-14 sm:py-20"
    x-data={`mockExam(${JSON.stringify(allQuestions)}, ${TOTAL}, ${DURATION})`}
    x-init="source = source.filter((q) => showsModule(q.cats)); init()"
  >
    <a href={withBase('/exercices')} class="text-sm text-ink-soft hover:text-laterite"><span x-text="t('exo.back')">← Tous les exercices</span></a>
    <h1 class="mt-3 font-display text-2xl sm:text-3xl font-semibold text-route"><span x-text="t('exam.title')">Examen blanc</span></h1>
    <p class="mt-2 text-sm text-ink-soft">
      {TOTAL} <span x-text="t('exam.intro1')">questions tirées au hasard de tous les modules,</span> {Math.round(DURATION / 60)} <span x-text="t('exam.intro2')">minutes pour les passer — comme un vrai passage à l'examen.</span>
    </p>

    <template x-if="!finished">
      <div>
        <div class="mt-6 flex items-center justify-between font-plate text-xs text-ink-soft">
          <span><span x-text="t('quiz.question')">Question</span> <span x-text="index + 1"></span> / <span x-text="total"></span></span>
          <span
            class="rounded-full px-3 py-1 font-semibold"
            :class="timeLeft <= 60 ? 'bg-laterite/15 text-laterite' : 'bg-route/5 text-route'"
          >
            <span x-text="minutes"></span>:<span x-text="seconds"></span>
          </span>
        </div>

        <div class="mt-3 h-1.5 w-full rounded-full bg-route/10">
          <div class="h-full rounded-full bg-signal transition-all" :style="`width: ${(index / total) * 100}%`"></div>
        </div>

        <div class="mt-6 rounded-2xl border border-route/10 bg-white/70 p-6">
          <p class="font-display text-lg font-semibold text-route" x-text="current.question"></p>
          <div class="mt-5 space-y-2.5">
            <template x-for="(choice, i) in current.choices" :key="i">
              <button
                type="button"
                @click="choose(i)"
                :class="{ 'border-ravinala bg-ravinala/10 text-route': selected !== null && i === current.correctIndex, 'border-laterite bg-laterite/10 text-route': selected === i && i !== current.correctIndex, 'border-route/15 hover:border-signal/40': selected === null, 'border-route/10 opacity-60': selected !== null && i !== current.correctIndex && i !== selected }"
                class="w-full rounded-xl border-2 px-4 py-3 text-left text-sm font-medium transition"
              >
                <span x-text="choice"></span>
              </button>
            </template>
          </div>

          <p x-show="selected !== null" x-cloak class="mt-4 rounded-lg bg-sun/15 p-3 text-sm text-route" x-text="current.explanation"></p>

          <div class="mt-5 flex justify-end">
            <button
              type="button"
              x-show="selected !== null"
              x-cloak
              @click="next()"
              class="rounded-full bg-route px-5 py-2 text-sm font-semibold text-sisal hover:bg-route/90"
              x-text="index === pool.length - 1 ? t('action.seeResult') : t('action.nextQuestion')"
            ></button>
          </div>
        </div>
      </div>
    </template>

    <template x-if="finished">
      <div class="mt-6 rounded-2xl border-2 p-8 text-center" :class={`score >= ${PASS_THRESHOLD} ? 'border-ravinala bg-ravinala/5' : 'border-laterite bg-laterite/5'`}>
        <p class="font-plate text-xs uppercase tracking-widest text-ink-soft"><span x-text="t('quiz.result')">Résultat</span></p>
        <p class="mt-2 font-display text-5xl font-semibold text-route">
          <span x-text="score"></span> / <span x-text="total"></span>
        </p>
        <p
          class="mt-3 inline-block rounded-full px-4 py-1.5 text-sm font-semibold"
          :class={`score >= ${PASS_THRESHOLD} ? 'bg-ravinala text-sisal' : 'bg-laterite text-sisal'`}
          x-text="score >= 16 ? t('exam.pass') : t('exam.fail')"
        ></p>
        <p class="mt-4 text-xs text-ink-soft">
          <span x-text="t('exam.threshold1')">Seuil indicatif :</span> {PASS_THRESHOLD}/{TOTAL} ({Math.round((PASS_THRESHOLD / TOTAL) * 100)}%) <span x-text="t('exam.threshold2')">— à titre d'entraînement, confirme le barème réel auprès de ton auto-école.</span>
        </p>
        <div class="mt-6 flex justify-center gap-3">
          <button type="button" @click="restart()" class="rounded-full bg-laterite px-5 py-2.5 text-sm font-semibold text-sisal hover:bg-laterite-dark"><span x-text="t('action.restart')">Recommencer</span></button>
          <a href={withBase('/cours')} class="rounded-full border-2 border-route px-5 py-2.5 text-sm font-semibold text-route hover:bg-route hover:text-sisal"><span x-text="t('exam.reviewCourse')">Revoir le cours</span></a>
        </div>
      </div>
    </template>
  </section>
</Layout>
